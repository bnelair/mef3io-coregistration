# Normalize line endings across platforms.
# Everything Git detects as text is stored LF in the repo and checked out LF
# everywhere, regardless of the cloner's core.autocrlf. Without this, a clone on
# Windows rewrites the tree to CRLF, which shows up as every file "modified" on
# Linux/macOS.
* text=auto eol=lf

# MEF 3.0 sessions and other binaries: never touch these bytes. MEF 3.0 files
# carry CRCs that would not survive EOL translation (none are committed today;
# test recordings are generated, but a fixture added later must stay intact).
*.tdat binary
*.tidx binary
*.tmet binary
*.rdat binary
*.ridx binary
*.tar  binary
*.npz  binary
*.png  binary
*.jpg  binary
*.gif  binary
*.pdf  binary
